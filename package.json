{
  "name": "milton-estates-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json",
    "check:exports": "node scripts/check-exports.mjs",
    "check:assets": "node scripts/audit-assets.mjs",
    "build": "npm run typecheck && npm run check:exports && npm run check:assets && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "check:full": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
